APP_NAME="POS System"
# Plantilla del .env que viaja dentro de la app de escritorio. Copiala a .env.escritorio
# (no se versiona: lleva la APP_KEY) y compilá con compilar-escritorio.bat.
# Cada caja instalada es produccion: con APP_DEBUG=false cualquier error le muestra al
# usuario el stack trace con rutas, consultas y fragmentos de configuracion.
APP_ENV=production
# La misma en todas las compilaciones: cambiarla invalida las sesiones de las cajas ya
# instaladas. Si no hay, compilar-escritorio.ps1 genera una.
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_URL=http://localhost

DB_CONNECTION=sqlite

# Solo el valor sugerido en la pantalla de alta; cada caja guarda el suyo en la base.
MANAGER_API_URL=https://35-226-112-51.sslip.io/api/v1
PUNTO_DE_VENTA_ID=
PUNTO_DE_VENTA_SECRET=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
# database, no sync: con sync el push al Manager correria dentro de la venta y bloquearia la caja.
QUEUE_CONNECTION=database

NATIVEPHP_APP_ID=com.pos.caja
# La escribe compilar-escritorio.ps1 con -Version. Subirla es lo que hace correr las
# migraciones en las cajas al actualizar.
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_UPDATER_ENABLED=false
