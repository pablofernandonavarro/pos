APP_NAME="POS System"
# Cada caja instalada es produccion: con APP_DEBUG=true cualquier error le muestra al
# usuario el stack trace con rutas, consultas y fragmentos de configuracion.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_URL=http://localhost

DB_CONNECTION=sqlite
# Sin DB_DATABASE: Laravel usa database/database.sqlite de ESTA instalacion.
# No poner una ruta absoluta aca: al instalar una segunda caja en la misma maquina,
# las dos terminarian escribiendo en la misma base.

# Manager API Configuration
MANAGER_API_URL=http://manager.test/api/v1
PUNTO_DE_VENTA_ID=
PUNTO_DE_VENTA_SECRET=

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
# error y no debug: en una caja el log crece sin que nadie lo mire ni lo rote.
LOG_LEVEL=error

# Session & Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
# CACHE_STORE, no CACHE_DRIVER: en Laravel 11+ la variable se renombro y la vieja se
# ignora. Sin esto la cache cae en "database", que necesita una tabla `cache` que el POS
# no migra, y el worker muere al arrancar por el lock de ShouldBeUnique.
# Ademas "file" no depende de nada externo, que es lo que corresponde en una caja offline.
CACHE_STORE=file
# database, no sync: con sync el push al Manager correria dentro de la venta y bloquearia la caja.
QUEUE_CONNECTION=database
